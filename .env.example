# ── OPEN WEIGHT UPDATE ──────────────────────────────────────────────────────
# OLD: This POC used Groq's hosted API (required an external API key,
# patient data left your machine on every question).
#
#   GROQ_API_KEY=your_groq_api_key_here
#   # Get your free key at: https://console.groq.com
# ─────────────────────────────────────────────────────────────────────────────

# NEW: Local inference via Ollama. No API key needed — nothing leaves
# your machine. Only set these if your Ollama server isn't on localhost
# or you want a different model than the default (llama3.1:8b).

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
